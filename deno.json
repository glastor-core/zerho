{
  "name": "@zerhopress/core",
  "version": "1.1.0",
  "description": "Next-generation documentation engine for Deno & Deno Deploy with live interactive playground, Monaco editor, OpenAPI explorer and Edge AI search",
  "exports": {
    ".": "./main.ts",
    "./cli": "./src/cli.ts",
    "./builder": "./src/core/builder.ts",
    "./openapi": "./src/core/openapi.ts"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv --watch src/core/dev.ts",
    "build": "deno run --allow-net --allow-read --allow-write --allow-env src/core/builder.ts",
    "serve": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv main.ts",
    "cli": "deno run -A --unstable-kv src/cli.ts",
    "stats": "deno run -A --unstable-kv src/cli.ts stats",
    "test": "deno test -A --unstable-kv",
    "test:cov": "deno test -A --unstable-kv --coverage=coverage && deno coverage coverage",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check main.ts src/cli.ts src/core/*.ts tests/*.ts",
    "ci": "deno task check && deno task lint && deno task fmt:check && deno task test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.14",
    "@std/http": "jsr:@std/http@^1.0.13",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/yaml": "jsr:@std/yaml@^1.0.5",
    "marked": "npm:marked@^15.0.7",
    "prismjs": "npm:prismjs@^1.30.0",
    "prismjs/components/prism-typescript": "npm:prismjs@^1.30.0/components/prism-typescript.js",
    "prismjs/components/prism-bash": "npm:prismjs@^1.30.0/components/prism-bash.js",
    "prismjs/components/prism-json": "npm:prismjs@^1.30.0/components/prism-json.js",
    "prismjs/components/prism-yaml": "npm:prismjs@^1.30.0/components/prism-yaml.js",
    "prismjs/components/prism-css": "npm:prismjs@^1.30.0/components/prism-css.js"
  },
  "lint": {
    "exclude": ["dist/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-window", "no-window-prefix", "no-explicit-any"]
    }
  },
  "fmt": {
    "exclude": ["dist/"],
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false
  },
  "test": {
    "exclude": ["dist/"],
    "include": ["tests/"]
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable", "dom"]
  }
}
