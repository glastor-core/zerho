{
  "name": "@zerhopress/core",
  "version": "1.1.0",
  "description": "Next-generation documentation engine for Deno & Deno Deploy with live interactive playground, Monaco editor, OpenAPI explorer and Edge AI search",
  "exports": {
    ".": "./main.ts",
    "./cli": "./src/cli.ts",
    "./builder": "./src/core/builder.ts",
    "./openapi": "./src/core/openapi.ts"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv --watch src/core/dev.ts",
    "build": "deno run --allow-net --allow-read --allow-write --allow-env src/core/builder.ts",
    "serve": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv main.ts",
    "cli": "deno run -A --unstable-kv src/cli.ts",
    "stats": "deno run -A --unstable-kv src/cli.ts stats"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.14",
    "@std/http": "jsr:@std/http@^1.0.13",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/yaml": "jsr:@std/yaml@^1.0.5",
    "marked": "npm:marked@^15.0.7",
    "prismjs": "npm:prismjs@^1.30.0"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"]
  }
}
